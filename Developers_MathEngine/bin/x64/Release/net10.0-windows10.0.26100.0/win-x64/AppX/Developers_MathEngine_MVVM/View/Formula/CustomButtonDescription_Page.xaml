<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Developers_MathEngine_MVVM.View.Formula.CustomButtonDescription_Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Developers_MathEngine_MVVM.View.Formula"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:FormulaModel="using:Developers_MathEngine_MVVM.Model.Formula"
    xmlns:DependencyInjection="using:Developers_MathEngine_MVVM.Dependency_Injection"
    mc:Ignorable="d">

    <Page.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_DefaultFormat_Theme}"></Style>
        <Style TargetType="Button" BasedOn="{StaticResource Button_DefaultFormat_Theme}"></Style>
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer_DefaultFormat_Theme}"></Style>
        <Style TargetType="StackPanel" BasedOn="{StaticResource StackPanel_DefaultFormat_Theme}"></Style>
        <Style TargetType="Controls:WrapPanel" BasedOn="{StaticResource WrapPanel_DefaultFormat_Theme}"></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource TextBox_DefaultFormat_Theme}"></Style>
        <Style TargetType="Border" BasedOn="{StaticResource Border_DefaultFormat_Theme}"></Style>
    </Page.Resources>
    
    <ScrollViewer>
        <!--<StackPanel Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                -->
        <!--<TextBlock Grid.Column="0" Text="{x:Bind customButton_ViewModel.selectedCustomButton.FormulaIndex, Mode=OneWay}" ></TextBlock>-->
        <!--
                <Button Grid.Column="1" Content="X" Command="{Binding ElementName=FormulaList_ItemsControl, Path=DataContext.deleteFormulaCommand}" CommandParameter="{Binding}"></Button>

                <Button Grid.Column="2" Content="" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" x:Name="Expand_FormulaSection" Command="{Binding ElementName=FormulaList_ItemsControl,Path=DataContext.expandFormulaSectionCommand}" CommandParameter="{Binding ElementName=FormulaSection}"></Button>

            </Grid>-->
        <StackPanel x:Name="FormulaSection" Orientation="Vertical" Margin="10">
            <Controls:WrapPanel Orientation="Horizontal">
                <Button Content="Get Variables" Command="{x:Bind DependencyInjection:DependencyInjectionShared.formula_ViewModel.getVariableCommand, Mode=OneWay}" CommandParameter="{x:Bind customButton_ViewModel.selectedCustomButton, Mode=OneWay}"></Button>
                <Button Content="Solve" Command="{x:Bind DependencyInjection:DependencyInjectionShared.formula_ViewModel.solveCommand, Mode=OneWay}" CommandParameter="{x:Bind customButton_ViewModel.selectedCustomButton, Mode=OneWay}"></Button>
                <Button Content="Update Button" Command="{x:Bind customButton_ViewModel.updateCustomButtonCommand,Mode=OneWay}" CommandParameter="{x:Bind customButton_ViewModel.selectedCustomButton, Mode=OneWay}"></Button>
            </Controls:WrapPanel>
            <Controls:WrapPanel Orientation="Horizontal">
                <Button Content="Quick Solve" Command="{x:Bind DependencyInjection:DependencyInjectionShared.formula_ViewModel.quickSolveFormulaCommand, Mode=OneWay}" CommandParameter="{x:Bind customButton_ViewModel.selectedCustomButton, Mode=OneWay}"></Button>
            </Controls:WrapPanel>


            <StackPanel Orientation="Vertical">
                <TextBlock Text="{x:Bind customButton_ViewModel.selectedCustomButton.FormulaName,Mode=OneWay}"></TextBlock>
                <TextBox PreviewKeyDown="TabKeyDown_Textbox_PreviewKeyDown" BringIntoViewRequested="Textbox_BringIntoViewRequested" Text="{x:Bind customButton_ViewModel.selectedCustomButton.VariableExec_Script.Script,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Variable" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                <TextBox PreviewKeyDown="TabKeyDown_Textbox_PreviewKeyDown" BringIntoViewRequested="Textbox_BringIntoViewRequested" Text="{x:Bind customButton_ViewModel.selectedCustomButton.FormulaExec_Script.Script,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Formula" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                <TextBox PreviewKeyDown="TabKeyDown_Textbox_PreviewKeyDown" BringIntoViewRequested="Textbox_BringIntoViewRequested" Text="{x:Bind customButton_ViewModel.selectedCustomButton.Solution,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Solution" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                <TextBox PreviewKeyDown="TabKeyDown_Textbox_PreviewKeyDown" BringIntoViewRequested="Textbox_BringIntoViewRequested" Text="{x:Bind customButton_ViewModel.selectedCustomButton.Description,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Description" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                <TextBox PreviewKeyDown="TabKeyDown_Textbox_PreviewKeyDown" BringIntoViewRequested="Textbox_BringIntoViewRequested" Text="{x:Bind customButton_ViewModel.selectedCustomButton.Use,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Description" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
            </StackPanel>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Rules:"></TextBlock>
                <Controls:WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="Add Rules"></Button>
                    <Button Content="Clear Rules"></Button>
                </Controls:WrapPanel>
                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <ItemsControl ItemsSource="{x:Bind customButton_ViewModel.selectedCustomButton.Rules_Collection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="FormulaModel:Rule">
                                <Grid>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="StackPanel" BasedOn="{StaticResource StackPanel_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Controls:WrapPanel" BasedOn="{StaticResource WrapPanel_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource TextBox_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Border_DefaultFormat_Theme}"></Style>

                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0">
                                        <TextBlock Text="{x:Bind ruleIndex,Mode=OneWay}"></TextBlock>
                                    </Border>
                                    <Button Grid.Column="0" Content="X"></Button>
                                    <TextBox PreviewKeyDown="TabKeyDown_Textbox_PreviewKeyDown" BringIntoViewRequested="Textbox_BringIntoViewRequested" Text="{x:Bind codeRule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" PlaceholderText="Rules" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Variables:"></TextBlock>
                <StackPanel Grid.Row="1" Orientation="Vertical">
                    <ItemsControl ItemsSource="{x:Bind customButton_ViewModel.selectedCustomButton.Variable_Collection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="FormulaModel:Variable">
                                <Grid>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="StackPanel" BasedOn="{StaticResource StackPanel_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Controls:WrapPanel" BasedOn="{StaticResource WrapPanel_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource TextBox_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Border_DefaultFormat_Theme}"></Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0">
                                        <TextBlock Text="{x:Bind VariableIndex, Mode=OneWay}"></TextBlock>
                                    </Border>

                                    <Border Grid.Column="1">
                                        <TextBlock Text="{x:Bind VariableName, Mode=OneWay}"></TextBlock>
                                    </Border>
                                    <Controls:GridSplitter Grid.Column="2"></Controls:GridSplitter>
                                    <TextBox PreviewKeyDown="TabKeyDown_Textbox_PreviewKeyDown" BringIntoViewRequested="Textbox_BringIntoViewRequested" Grid.Column="3" PlaceholderText="Variable Value" Text="{x:Bind VariableValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False"></TextBox>
                                    <Controls:GridSplitter Grid.Column="4"></Controls:GridSplitter>
                                    <TextBox PreviewKeyDown="TabKeyDown_Textbox_PreviewKeyDown" BringIntoViewRequested="Textbox_BringIntoViewRequested" Grid.Column="5" PlaceholderText="Variable Description" Text="{x:Bind VariableDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False"></TextBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>


        </StackPanel>
        <!--</StackPanel>-->
    </ScrollViewer>
</Page>
