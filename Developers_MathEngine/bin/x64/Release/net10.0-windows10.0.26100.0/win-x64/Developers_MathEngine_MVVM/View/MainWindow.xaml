<?xml version="1.0" encoding="utf-8"?>
<Window x:ConnectionId='1'
    x:Class="Developers_MathEngine_MVVM.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Developers_MathEngine_MVVM.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Developer's Math Engine"
                                    >

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Margin="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Grid.Resources>
            <!--<Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_DefaultFormat_Theme}"></Style>-->
            <Style TargetType="Button" BasedOn="{StaticResource Button_DefaultFormat_Theme}"></Style>
            <!--<Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer_DefaultFormat_Theme}"></Style>-->
            <!--<Style TargetType="StackPanel" BasedOn="{StaticResource StackPanel_DefaultFormat_Theme}"></Style>-->
            <!--<Style TargetType="Controls:WrapPanel" BasedOn="{StaticResource WrapPanel_DefaultFormat_Theme}"></Style>-->
            <!--<Style TargetType="TextBox" BasedOn="{StaticResource TextBox_DefaultFormat_Theme}"></Style>-->
            <!--<Style TargetType="Border" BasedOn="{StaticResource Border_DefaultFormat_Theme}"></Style>-->

        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <!--Menu-->
            <RowDefinition Height="auto"></RowDefinition>
            <!--Template Tab-->
            <RowDefinition Height="auto"></RowDefinition>
            <!--NavigationFrame-->
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Top" Orientation="Horizontal">

            <Button Content="File">
                <Button.Flyout>
                    <MenuBarItemFlyout>
                        <MenuFlyoutItem x:ConnectionId='5' Text="Save"                                                                     ></MenuFlyoutItem>
                        <MenuFlyoutItem x:ConnectionId='6' Text="Load"                                                                     ></MenuFlyoutItem>
                        <!--<MenuFlyoutItem Text="Append"></MenuFlyoutItem>-->
                    </MenuBarItemFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <Button x:ConnectionId='3' x:Name="NewWindow_Button" Content="New Window"                               ></Button>
                <Button x:ConnectionId='4' x:Name="Preset_Formula_Button" Content="Formula"                                    ></Button>
                <!--<Button x:Name="PresetGraphing_Button" Content="Graphing"></Button>-->
                <!--<Button x:Name="PresetUnitCircle_Button" Content="Unit Circle"></Button>-->
            </StackPanel>
        </ScrollViewer>



        <Grid Grid.Row="2" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Frame x:ConnectionId='2' x:FieldModifier="public" x:Name="PageViewer_Frame"                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            </Frame>
        </Grid>

    </Grid>
</Window>

