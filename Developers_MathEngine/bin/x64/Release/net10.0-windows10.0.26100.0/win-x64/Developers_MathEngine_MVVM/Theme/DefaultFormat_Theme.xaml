<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Developers_MathEngine_MVVM.Theme">

    <Style TargetType="Border" x:Key="Border_DefaultFormat_Theme">
        <!--<Setter Property="Height" Value="25"></Setter>-->
        <Setter Property="Margin" Value="1"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="BorderBrush" Value="DarkGray"></Setter>
    </Style>

    <Style TargetType="Button" x:Key="Button_DefaultFormat_Theme">
        <Setter Property="Margin" Value="1"></Setter>
    </Style>


    <Style TargetType="TextBlock" x:Key="TextBlock_DefaultFormat_Theme">
        <Setter Property="Margin" Value="7"></Setter>
        <Setter Property="MinWidth" Value="15"></Setter>
        <Setter Property="FontSize" Value="17"></Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="TextBox_DefaultFormat_Theme">
        <Setter Property="Margin" Value="1"></Setter>
        <Setter Property="FontSize" Value="17"></Setter>
    </Style>



    <Style TargetType="ScrollViewer" x:Key="ScrollViewer_DefaultFormat_Theme">
        <Setter Property="Margin" Value="1"></Setter>
    </Style>



    <Style TargetType="StackPanel" x:Key="StackPanel_DefaultFormat_Theme">
        <Setter Property="Margin" Value="2"></Setter>
    </Style>


    <Style TargetType="Controls:WrapPanel" x:Key="WrapPanel_DefaultFormat_Theme">
        <Setter Property="Margin" Value="1"></Setter>
    </Style>

</ResourceDictionary>

