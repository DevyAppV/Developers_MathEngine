<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="Developers_MathEngine_MVVM.View.Formula.Formula_Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Developers_MathEngine_MVVM.View.Formula"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ProjectModel ="using:Developers_MathEngine_MVVM.Model.Project"
    xmlns:FormulaModel ="using:Developers_MathEngine_MVVM.Model.Formula"
    mc:Ignorable="d">



    <Grid>

        <Grid.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_DefaultFormat_Theme}"></Style>
            <Style TargetType="Button" BasedOn="{StaticResource Button_DefaultFormat_Theme}"></Style>
            <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer_DefaultFormat_Theme}"></Style>
            <Style TargetType="StackPanel" BasedOn="{StaticResource StackPanel_DefaultFormat_Theme}"></Style>
            <Style TargetType="Controls:WrapPanel" BasedOn="{StaticResource WrapPanel_DefaultFormat_Theme}"></Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource TextBox_DefaultFormat_Theme}"></Style>
            <Style TargetType="Border" BasedOn="{StaticResource Border_DefaultFormat_Theme}"></Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock x:ConnectionId='2' Grid.Row="0"                                                                  ></TextBlock>
        <Controls:WrapPanel Grid.Row="1" Orientation="Horizontal">
            <Button x:ConnectionId='33' Content="Add"                                                                    ></Button>
            <Button x:ConnectionId='34' Content="Clear"                                                                          ></Button>
        </Controls:WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <ItemsControl x:ConnectionId='3' x:Name="FormulaList_ItemsControl"                                                                                                                                          >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate                                  >
                            <StackPanel x:ConnectionId='5' Orientation="Vertical">

                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_DefaultFormat_Theme}"></Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button_DefaultFormat_Theme}"></Style>
                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer_DefaultFormat_Theme}"></Style>
                                    <Style TargetType="StackPanel" BasedOn="{StaticResource StackPanel_DefaultFormat_Theme}"></Style>
                                    <Style TargetType="Controls:WrapPanel" BasedOn="{StaticResource WrapPanel_DefaultFormat_Theme}"></Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Border_DefaultFormat_Theme}"></Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource TextBox_DefaultFormat_Theme}"></Style>
                                </StackPanel.Resources>
                                <Grid Height="5">

                                </Grid>

                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0">
                                            <TextBlock x:ConnectionId='32'                                           ></TextBlock>
                                        </Border>
                                        <Button Grid.Column="1" Content="X" Command="{Binding ElementName=FormulaList_ItemsControl, Path=DataContext.deleteFormulaCommand}" CommandParameter="{Binding}"></Button>

                                        <Button x:ConnectionId='31' Grid.Column="2"                                                                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" x:Name="Expand_FormulaSection" Command="{Binding ElementName=FormulaList_ItemsControl,Path=DataContext.expandFormulaSectionCommand}" CommandParameter="{Binding ElementName=FormulaSection}"></Button>

                                    </Grid>
                                    <StackPanel x:Name="FormulaSection" Orientation="Vertical" Visibility="Collapsed">
                                        <Controls:WrapPanel Orientation="Horizontal">
                                            <Button x:ConnectionId='28' Content="Get Variables" Command="{Binding ElementName=FormulaList_ItemsControl, Path=DataContext.getVariableCommand}"                            ></Button>
                                            <Button x:ConnectionId='29' Content="Solve" Command="{Binding ElementName=FormulaList_ItemsControl, Path=DataContext.solveCommand}"                            ></Button>
                                            <Button x:ConnectionId='30' Content="Create Button" Command="{Binding ElementName=FormulaList_ItemsControl, Path=DataContext.createCustomButtonCommand}"                            ></Button>
                                        </Controls:WrapPanel>
                                        <Controls:WrapPanel>
                                            <Button x:ConnectionId='27' Content="Quick Solve" Command="{Binding ElementName=FormulaList_ItemsControl, Path=DataContext.quickSolveFormulaCommand}"                            ></Button>
                                        </Controls:WrapPanel>

                                        <StackPanel Orientation="Vertical">
                                            <TextBox x:ConnectionId='22' x:Name="FormulaName_Textbox"                                                                                                                                                                                        PlaceholderText="Formula Name" AcceptsReturn="False" IsSpellCheckEnabled="False"></TextBox>
                                            <TextBox x:ConnectionId='23' x:Name="VariableExecScript_Textbox"                                                                                                                                                                                                                                                        PlaceholderText="Variable" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                                            <TextBox x:ConnectionId='24' x:Name="FormulaExecScript_Textbox"                                                                                                                                                                                                                                                       PlaceholderText="Formula" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                                            <TextBox x:ConnectionId='25' x:Name="Solution_Textbox"                                                                                                                                                                                                                                      PlaceholderText="Solution" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                                            <TextBox x:ConnectionId='26' x:Name="Description_Textbox"                                                                                                                                                                                                                                         PlaceholderText="Description" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Rules:"></TextBlock>
                                            <Controls:WrapPanel Grid.Row="1" Orientation="Horizontal">
                                                <Button x:ConnectionId='20' Content="Add Rules" Command="{Binding ElementName=FormulaList_ItemsControl, Path=DataContext.addRuleCommand}"                            ></Button>
                                                <Button x:ConnectionId='21' Content="Clear Rules" Command="{Binding ElementName=FormulaList_ItemsControl, Path=DataContext.clearRuleCommand}"                            ></Button>
                                            </Controls:WrapPanel>
                                            <StackPanel Grid.Row="2" Orientation="Vertical">
                                                <ItemsControl x:ConnectionId='14'                                                     >
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate                               >
                                                            <Grid x:ConnectionId='16'>
                                                                <Grid.Resources>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_DefaultFormat_Theme}"></Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource Button_DefaultFormat_Theme}"></Style>
                                                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer_DefaultFormat_Theme}"></Style>
                                                                    <Style TargetType="StackPanel" BasedOn="{StaticResource StackPanel_DefaultFormat_Theme}"></Style>
                                                                    <Style TargetType="Controls:WrapPanel" BasedOn="{StaticResource WrapPanel_DefaultFormat_Theme}"></Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource Border_DefaultFormat_Theme}"></Style>

                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource TextBox_DefaultFormat_Theme}"></Style>
                                                                </Grid.Resources>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0">
                                                                    <TextBlock x:ConnectionId='19'                                      ></TextBlock>
                                                                </Border>
                                                                <Button x:ConnectionId='17' Grid.Column="1" Content="X" Command="{Binding ElementName=FormulaList_ItemsControl, Path=DataContext.deleteRuleCommand}"                            ></Button>
                                                                <TextBox x:ConnectionId='18' x:Name="Rules_Textbox"                                                                                                                           Grid.Column="2"                                                                                                              PlaceholderText="Rules" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Variables:"></TextBlock>
                                            <StackPanel Grid.Row="1" Orientation="Vertical">
                                                <ItemsControl x:ConnectionId='7'                                                        >
                                                   
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate                                   >
                                                            <Grid x:ConnectionId='9'>
                                                                <Grid.Resources>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_DefaultFormat_Theme}"></Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource Button_DefaultFormat_Theme}"></Style>
                                                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer_DefaultFormat_Theme}"></Style>
                                                                <Style TargetType="StackPanel" BasedOn="{StaticResource StackPanel_DefaultFormat_Theme}"></Style>
                                                                <Style TargetType="Controls:WrapPanel" BasedOn="{StaticResource WrapPanel_DefaultFormat_Theme}"></Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource Border_DefaultFormat_Theme}"></Style>

                                                                <Style TargetType="TextBox" BasedOn="{StaticResource TextBox_DefaultFormat_Theme}"></Style>
                                                            </Grid.Resources>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <Border Grid.Column="0">
                                                                    <TextBlock x:ConnectionId='13'                                           ></TextBlock>
                                                                </Border>
                                                                <Border Grid.Column="1">
                                                                    <TextBlock x:ConnectionId='12' Grid.Column="1"                                          ></TextBlock>
                                                                </Border>
                                                                <Controls:GridSplitter Grid.Column="2"></Controls:GridSplitter>
                                                                <TextBox x:ConnectionId='10' Grid.Column="3" x:Name="VariableValue_Textbox"                                                                                                                           PlaceholderText="Variable Value"                                                                                                                   IsSpellCheckEnabled="False"></TextBox>
                                                                <Controls:GridSplitter Grid.Column="4"></Controls:GridSplitter>
                                                                <TextBox x:ConnectionId='11' Grid.Column="5" x:Name="VariableDescription_Textbox"                                                                                                                           PlaceholderText="Variable Description"                                                                                                                         IsSpellCheckEnabled="False"></TextBox>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>


                                    </StackPanel>
                                </StackPanel>

                                <Grid Height="5">

                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

