<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="Developers_MathEngine_MVVM.View.Formula.CustomButtonDescription_Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Developers_MathEngine_MVVM.View.Formula"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:FormulaModel="using:Developers_MathEngine_MVVM.Model.Formula"
    xmlns:DependencyInjection="using:Developers_MathEngine_MVVM.Dependency_Injection"
    mc:Ignorable="d">

    <Page.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_DefaultFormat_Theme}"></Style>
        <Style TargetType="Button" BasedOn="{StaticResource Button_DefaultFormat_Theme}"></Style>
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer_DefaultFormat_Theme}"></Style>
        <Style TargetType="StackPanel" BasedOn="{StaticResource StackPanel_DefaultFormat_Theme}"></Style>
        <Style TargetType="Controls:WrapPanel" BasedOn="{StaticResource WrapPanel_DefaultFormat_Theme}"></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource TextBox_DefaultFormat_Theme}"></Style>
        <Style TargetType="Border" BasedOn="{StaticResource Border_DefaultFormat_Theme}"></Style>
    </Page.Resources>
    
    <ScrollViewer>
        <!--<StackPanel Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                -->
        <!--<TextBlock Grid.Column="0" Text="{x:Bind customButton_ViewModel.selectedCustomButton.FormulaIndex, Mode=OneWay}" ></TextBlock>-->
        <!--
                <Button Grid.Column="1" Content="X" Command="{Binding ElementName=FormulaList_ItemsControl, Path=DataContext.deleteFormulaCommand}" CommandParameter="{Binding}"></Button>

                <Button Grid.Column="2" Content="" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" x:Name="Expand_FormulaSection" Command="{Binding ElementName=FormulaList_ItemsControl,Path=DataContext.expandFormulaSectionCommand}" CommandParameter="{Binding ElementName=FormulaSection}"></Button>

            </Grid>-->
        <StackPanel x:ConnectionId='2' x:Name="FormulaSection" Orientation="Vertical" Margin="10">
            <Controls:WrapPanel Orientation="Horizontal">
                <Button x:ConnectionId='22' Content="Get Variables"                                                                                                                                                                                                        ></Button>
                <Button x:ConnectionId='23' Content="Solve"                                                                                                                                                                                                  ></Button>
                <Button x:ConnectionId='24' Content="Update Button"                                                                                                                                                                     ></Button>
            </Controls:WrapPanel>
            <Controls:WrapPanel Orientation="Horizontal">
                <Button x:ConnectionId='21' Content="Quick Solve"                                                                                                                                                                                                              ></Button>
            </Controls:WrapPanel>


            <StackPanel Orientation="Vertical">
                <TextBlock x:ConnectionId='15'                                                                                    ></TextBlock>
                <TextBox x:ConnectionId='16'                                                                                                                                                                                                                                                   PlaceholderText="Variable" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                <TextBox x:ConnectionId='17'                                                                                                                                                                                                                                                  PlaceholderText="Formula" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                <TextBox x:ConnectionId='18'                                                                                                                                                                                                                                 PlaceholderText="Solution" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                <TextBox x:ConnectionId='19'                                                                                                                                                                                                                                    PlaceholderText="Description" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                <TextBox x:ConnectionId='20'                                                                                                                                                                                                                            PlaceholderText="Description" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
            </StackPanel>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Rules:"></TextBlock>
                <Controls:WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="Add Rules"></Button>
                    <Button Content="Clear Rules"></Button>
                </Controls:WrapPanel>
                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <ItemsControl x:ConnectionId='10'                                                                                                                                      >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                               >
                                <Grid x:ConnectionId='12'>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="StackPanel" BasedOn="{StaticResource StackPanel_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Controls:WrapPanel" BasedOn="{StaticResource WrapPanel_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource TextBox_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Border_DefaultFormat_Theme}"></Style>

                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0">
                                        <TextBlock x:ConnectionId='14'                                      ></TextBlock>
                                    </Border>
                                    <Button Grid.Column="0" Content="X"></Button>
                                    <TextBox x:ConnectionId='13'                                                                                                                                                                                       Grid.Column="1" PlaceholderText="Rules" AcceptsReturn="True" IsSpellCheckEnabled="False"></TextBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Variables:"></TextBlock>
                <StackPanel Grid.Row="1" Orientation="Vertical">
                    <ItemsControl x:ConnectionId='3'                                                                                                                                         >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                                   >
                                <Grid x:ConnectionId='5'>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="StackPanel" BasedOn="{StaticResource StackPanel_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Controls:WrapPanel" BasedOn="{StaticResource WrapPanel_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource TextBox_DefaultFormat_Theme}"></Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Border_DefaultFormat_Theme}"></Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0">
                                        <TextBlock x:ConnectionId='9'                                           ></TextBlock>
                                    </Border>

                                    <Border Grid.Column="1">
                                        <TextBlock x:ConnectionId='8'                                          ></TextBlock>
                                    </Border>
                                    <Controls:GridSplitter Grid.Column="2"></Controls:GridSplitter>
                                    <TextBox x:ConnectionId='6'                                                                                                            Grid.Column="3" PlaceholderText="Variable Value"                                                                                 IsSpellCheckEnabled="False"></TextBox>
                                    <Controls:GridSplitter Grid.Column="4"></Controls:GridSplitter>
                                    <TextBox x:ConnectionId='7'                                                                                                            Grid.Column="5" PlaceholderText="Variable Description"                                                                                       IsSpellCheckEnabled="False"></TextBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>


        </StackPanel>
        <!--</StackPanel>-->
    </ScrollViewer>
</Page>

